# Copie para .env. Nada aqui é segredo; em produção, use variáveis de ambiente do sistema.
REFRESCA_PREVISAO_DB_URL=sqlite:///./refresca_previsao.db
# Modelo treinado no repositório de ML (formato nativo do XGBoost).
# Deixe vazio para usar a heurística de linha de base.
REFRESCA_MODELO_PATH=modelos/modelo_refresca.json
# Opcional: por padrão, metadados.json na mesma pasta do modelo.
REFRESCA_METADADOS_PATH=
# Opcional: vazio usa o limiar escolhido no notebook de ML (0,46), ou 0,5 na heurística.
REFRESCA_LIMIAR_PERIGO=
